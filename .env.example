# =====================================================================
# Cloud Assignment Submission Portal - backend configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# In the cloud, set these as environment variables / secrets on the host.
# =====================================================================

# ---- General ----
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
APP_NAME=Cloud Assignment Submission Portal
# Public URL of this API (used to build signed download links for local storage)
PUBLIC_API_URL=http://localhost:8000

# ---- Security ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt cost factor (12 recommended; higher = slower to crack, slower to log in)
BCRYPT_ROUNDS=12
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max login/register attempts per IP per minute
RATE_LIMIT_PER_MINUTE=20

# ---- Cloud database ----
# Local:  sqlite:///./portal.db
# Cloud:  postgresql://USER:PASSWORD@HOST:5432/postgres   (Supabase / Neon / Render / RDS)
DATABASE_URL=sqlite:///./portal.db

# ---- Object storage ----
# local = files in LOCAL_STORAGE_DIR (development)
# s3    = any S3-compatible bucket (AWS S3, Supabase Storage, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage_data

# Only needed when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS S3. Examples:
#   Supabase: https://<project-ref>.supabase.co/storage/v1/s3
#   R2:       https://<account-id>.r2.cloudflarestorage.com
#   MinIO:    http://localhost:9000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only if the browser must use a different host than the API (e.g. MinIO in Docker:
# API uses http://minio:9000, browser uses http://localhost:9000)
S3_PUBLIC_ENDPOINT_URL=
# AES256 on AWS S3 (leave empty for providers that encrypt by default)
S3_SERVER_SIDE_ENCRYPTION=
# Lifetime of signed download URLs, in seconds
SIGNED_URL_EXPIRE_SECONDS=300

# ---- Submission policy ----
MAX_UPLOAD_MB=10
ALLOWED_FILE_TYPES=pdf,docx,pptx,zip,png,jpg,jpeg,txt,py,ipynb
# Defaults for new assignments (teachers can override per assignment)
ALLOW_LATE_SUBMISSIONS=true
ALLOW_RESUBMISSION=true

# ---- Demo data (python -m backend.seed) ----
# Password given to every fictional demo account. Local demos only.
SEED_DEMO_PASSWORD=
